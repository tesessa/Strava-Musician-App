{
  "name": "strava-musician-app",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prestart": "npm run build -w packages/shared",
    "start": "concurrently --names \"web,backend,ai\" --kill-others \"npm run start:web\" \"npm run start:backend\" \"npm run start:ai\"",
    "start:web": "npm run dev -w apps/web",
    "start:backend": "npm run dev -w apps/backend",
    "build": "npm run build -w packages/shared && npm run build -w apps/web && npm run build -w apps/backend",
    "database_test": "NODE_ENV=test jest --runInBand",
    "start:ai": "venv/bin/python -m uvicorn apps.backend.ai.ai_service:app --host 0.0.0.0 --port 8000"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^7.2.0",
    "concurrently": "^8.2.2",
    "jest": "^30.2.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6"
  },
  "dependencies": {
    "concurrently": "^8.2.2",
    "dotenv": "^17.3.1",
    "knex": "^3.1.0",
    "lucide-react": "^0.575.0",
    "pg": "^8.19.0",
    "postgres": "^3.4.8",
    "ts-node": "^10.9.2"
  }
}
